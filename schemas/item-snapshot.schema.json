{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"project": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"number": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"owner": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"url": {
					"type": "string",
					"pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])https:\\/\\/github\\.com\\/(?:users|orgs)\\/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\/projects\\/[1-9]\\d*$"
				}
			},
			"required": ["id", "number", "owner", "title"],
			"additionalProperties": false
		},
		"issue": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"number": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"repository": {
					"type": "string",
					"pattern": "^(?![\\s\\S]*[\\r\\n\\u2028\\u2029])[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\/[A-Za-z0-9._-]{1,100}$"
				}
			},
			"required": ["id", "number", "repository"],
			"additionalProperties": false
		},
		"itemId": {
			"type": "string",
			"minLength": 1
		},
		"isArchived": {
			"type": "boolean"
		},
		"fields": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"anyOf": [
					{
						"type": "string"
					},
					{
						"type": "null"
					}
				]
			}
		}
	},
	"required": ["project", "issue", "itemId", "isArchived", "fields"],
	"additionalProperties": false
}
