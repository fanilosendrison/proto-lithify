{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"error": {
			"type": "object",
			"properties": {
				"code": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["code", "message"]
		}
	},
	"required": ["schemaVersion", "error"]
}
